{
  "schemaVersion": 1,
  "id": "coinage",
  "version": "${version}",
  "name": "Coinage",
  "description": "A four-tier currency system with player purses, merchant trades, shops, and piggy banks.",
  "authors": [
    "pokesmells",
    "Bare Minimum Studios"
  ],
  "license": "BML-1.0",
  "icon": "assets/coinage/icon.png",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "net.bms.coinage.CoinageFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "net.bms.coinage.CoinageFabricClient"
      }
    ]
  },
  "mixins": [
    "coinage.mixins.json",
    "coinage.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}",
    "fabric-language-kotlin": ">=${fabricKotlinVersion}",
    "fzzy_config": ">=0.7.7"
  }
}
